input n:int = 20
input z:float = 1.5

let vw = vwap()
let m = sma(close, n)
let dev = abs(close - m)
let band = z * dev

signal mean_revert_long = close < (vw - band)
signal mean_revert_short = close > (vw + band)

on bar {
  if mean_revert_long { trade.enter_long(qty=0.1, sl_points=200, tp_points=200, tag="MRL") }
  if mean_revert_short { trade.enter_short(qty=0.1, sl_points=200, tp_points=200, tag="MRS") }
}
